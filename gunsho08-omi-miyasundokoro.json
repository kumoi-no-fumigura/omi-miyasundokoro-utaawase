   ],
   "lb": []
  },
  {
   "id": "gunsho08-omi-miyasundokoro-0002",
   "pid": "1879502",
   "pages": [
    472
   ],
   "text": "源順馬名合やまなしの花よの中をうしといひてもいつくにかみをは隱さむ山なしの花いはやなきいはやなき花色みれは山川の水のあやこそあやまたれけるみつゝしの花君をおもふ心にみつゝ忍はなん戀しきおりはあまたすくれと水のうへによるへ定めぬうき草もこのは流れて思ふへら也やまふきの花いろに深く思ひそめしをひとしほに咲そしにける山吹の花ふちのはな紫にいろあかりゆく藤の花こすゑたかくもなりにけるかな四條大納言公任卿以手跡本一留留者也。右近江御息所歌合以流布印本校合了",
   "poems": [
    "15",
    "16",
    "17",
    "18",
    "19",
    "20"
   ],
   "lb": [
    209
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "香をとめて折こそしけれ梅のはな春の霞はたちかくせとも",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "いつれをか枝ともわかむ靑柳の花もひとつに淺みとりなる",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "花さくらちる山川ははるも猶ともまちかほの雪かとそみる",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ふかれくるかには櫻そそひて散はるをゝくれぬ匂なるへし",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "鶯の木の花とのみいふなれはあふちとりをはすへんともせす",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あつさゆみ春の山邊に煙たちもゆともみえぬ火さくらの花",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "あるしとか我はく宿の庭さくらはな散ほとはてもふれてみん",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春たてはいつくともなし野はなりぬ若菜つむへ〓なりそしにける",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "咲しとき猶こそみしかもゝの花ちれはおしくそ思ひなりぬる",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "枝しあれはおひそしにける岩つゝし花咲迄にならんとやみし",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "わたつ海をこきゆく舟のかちの木の花とは更に波そたちける",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "いたつらに散やしぬらん山たかみ人もかよはぬ山ちさのはな",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "鳴こゑはあまたすれとも鶯にまさるとりのはなくそ有ける",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "春霞たちそめしより色かへて野はならしてよわかなつむへき",
   "kana": "",
   "speaker": "",
   "page": 471,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "よの中をうしといひてもいつくにかみをは隱さむ山なしの花",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "いはやなき花色みれは山川の水のあやこそあやまたれける",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "君をおもふ心にみつゝ忍はなん戀しきおりはあまたすくれと",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "水のうへによるへ定めぬうき草もこのは流れて思ふへら也",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いろに深く思ひそめしをひとしほに咲そしにける山吹の花",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "紫にいろあかりゆく藤の花こすゑたかくもなりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
